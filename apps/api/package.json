{
  "name": "@sapling/api",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "worker": "tsx src/workers/worker.ts",
    "start:worker": "node dist/workers/worker.js",
    "seed:dev": "tsx src/infrastructure/database/mongodb/seed.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@sapling/contracts": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^6.0.11",
    "mongoose": "^8.13.2",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "dotenv": "^16.5.0",
    "@aiquest/learning-core": "workspace:*",
    "@aiquest/client-sdk": "workspace:*",
    "@aws-sdk/client-sesv2": "^3.936.0",
    "@sentry/node": "^11.16.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.1"
  }
}
