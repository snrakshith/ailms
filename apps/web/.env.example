VITE_API_BASE=/api/v1
# Dev server proxy target when API is separate:
VITE_DEV_API_ORIGIN=http://localhost:4000
# Optional public DSN; never put secrets in VITE_ variables
VITE_SENTRY_DSN=
VITE_RELEASE=development

# Public Google OAuth Web client ID (not a secret)
VITE_GOOGLE_CLIENT_ID=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_MIXPANEL_TOKEN=
VITE_STATUS_PAGE_URL=
# For production builds, pass PUBLIC_SITE_URL=https://your-domain.example to Vite build.
