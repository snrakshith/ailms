{
  "name": "@sapling/web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node ../../scripts/seo/generate.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:coverage": "vitest run --coverage",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@sapling/contracts": "workspace:*",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.72.1",
    "@sentry/react": "^11.16.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.6.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.24.2",
    "@aiquest/learning-core": "workspace:*",
    "@aiquest/client-sdk": "workspace:*",
    "posthog-js": "^1.300.0",
    "mixpanel-browser": "^2.74.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/react": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "eslint": "^10.15.0",
    "postcss": "^8.5.3",
    "storybook": "^10.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "jsdom": "^26.1.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@playwright/test": "1.65.1"
  }
}
