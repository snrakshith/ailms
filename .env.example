# Copy to .env for local Compose. Never use these development secrets in production.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/aiquest
JWT_SECRET=replace-with-32-or-more-characters-local-dev-only-000000
COOKIE_SECURE=false
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
QUEUE_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aiquest-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
METRICS_TOKEN=replace-with-32-or-more-characters-local-dev-only-metrics
VITE_API_BASE=/api/v1

# P1: optional editorial and AI configuration (leave blank to disable)
CONTENT_AUTHORS=
CONTENT_REVIEWERS=
AIQUEST_LLM_KEY=
AIQUEST_LLM_MODEL=
AIQUEST_LLM_BASE_URL=https://api.openai.com/v1
# Optional model comparison: two provider-supported model IDs separated by a comma
AIQUEST_LLM_COMPARE_MODELS=

# Cashfree PG one-time learning pass (disable until configured)
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
# CASHFREE_CLIENT_ID=your-sandbox-client-id
# CASHFREE_CLIENT_SECRET=your-sandbox-client-secret
# CASHFREE_WEBHOOK_URL=https://your-public-api.example.com/api/v1/billing/webhook
# Illustrative editable price in paise, INR 499.00
GENAI_PASS_PRICE_PAISE=49900

# Optional Google Identity Services (same OAuth Web client ID for both sides)
# Set Authorized JavaScript origin to http://localhost:5173 for local dev
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# AI Quest v1.3 integrations (all optional / disabled by default)
SES_ENABLED=false
AWS_REGION=ap-south-1
SES_FROM_EMAIL=
SENTRY_DSN=
INVOICE_SELLER_NAME=AI Quest
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_GSTIN=
# The full URL of the public site; set this for sitemap/canonical generation during build
PUBLIC_SITE_URL=
# Separate externally hosted monitoring page, e.g. Better Stack; leave blank until provisioned
VITE_STATUS_PAGE_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=
